# /etc/sudoers.d/ai-media-rc
# Passwordless sudo for the service user — strictly limited to
# the commands used by the MCP Linux server.
# Replace MEDIA_USER with your actual username.
# Deployed by scripts/setup-auth.sh

# Service management (systemctl restart only)
MEDIA_USER ALL=(root) NOPASSWD: /usr/bin/systemctl restart sagetv
MEDIA_USER ALL=(root) NOPASSWD: /usr/bin/systemctl restart channels-dvr
MEDIA_USER ALL=(root) NOPASSWD: /usr/bin/systemctl restart docker
MEDIA_USER ALL=(root) NOPASSWD: /usr/bin/systemctl restart nginx
MEDIA_USER ALL=(root) NOPASSWD: /usr/bin/systemctl restart transcription
MEDIA_USER ALL=(root) NOPASSWD: /usr/bin/systemctl restart session-manager

# Docker operations (only for allowlisted containers)
MEDIA_USER ALL=(root) NOPASSWD: /usr/bin/docker restart sagetv-server

# Server power
MEDIA_USER ALL=(root) NOPASSWD: /usr/sbin/reboot
MEDIA_USER ALL=(root) NOPASSWD: /usr/sbin/shutdown -h now
