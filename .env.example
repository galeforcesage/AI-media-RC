# LLM Remote Orchestrator — Environment Configuration
# Copy to .env and fill in values for your deployment.
# This file is safe to commit; .env is NOT (see .gitignore).

# HTTP server
ORCHESTRATOR_HTTP_HOST=0.0.0.0
ORCHESTRATOR_HTTP_PORT=8000

# MCP server
ORCHESTRATOR_MCP_HOST=HOSTNAME_OR_IP
ORCHESTRATOR_MCP_PORT=8765

# SageTV backend (SageTV Docker exposes 8080, 7818, 31099)
SAGETV_HOST=HOSTNAME_OR_IP
SAGETV_WEB_PORT=8080

# ChannelsDVR backend
CHANNELS_HOST=HOSTNAME_OR_IP
CHANNELS_PORT=8089

# Model paths (relative or absolute)
LLM_MODEL_PATH=models/llm
WHISPER_MODEL_PATH=models/whisper
WHISPER_MODEL_SIZE=base
TTS_MODEL_PATH=models/tts
TTS_OUTPUT_DIR=/tmp/tts_output

# Debug mode
DEBUG=false

# ── Optional GPU-lease plugin ────────────────────────────────────────────
# The public app runs stand-alone against the static LLM_* endpoint above and
# needs none of the settings below. To share the GPU with other apps via a GPU
# resource broker, install the private plugin package and point the app at it:
#
#   pip install "gpu-resource-broker @ git+ssh://git@github.com/galeforcesage/gpu-priority-lock@<ref>"
#
# GPU_ROUTER_PLUGIN is a "module:attr" path to a LeaseManager implementation.
# Leave it unset to disable GPU arbitration entirely (default, no-op).
#GPU_ROUTER_PLUGIN=client.lease_manager:GpuRouterLeaseManager

# Broker connection (only read when the plugin is loaded).
#GPU_ROUTER_ENABLED=true
#GPU_ROUTER_URL=http://HOSTNAME_OR_IP:7235
#GPU_ROUTER_APPLICATION_ID=my-app
#GPU_ROUTER_TOKEN=
#GPU_ROUTER_REQUEST_TIMEOUT_SECONDS=10

