# LLM Remote Orchestrator — Environment Configuration
# Copy to .env and fill in values for your deployment.
# This file is safe to commit; .env is NOT (see .gitignore).

# HTTP server
ORCHESTRATOR_HTTP_HOST=0.0.0.0
ORCHESTRATOR_HTTP_PORT=8000

# MCP server
ORCHESTRATOR_MCP_HOST=127.0.0.1
ORCHESTRATOR_MCP_PORT=8765

# SageTV backend (SageTV Docker exposes 8080, 7818, 31099)
SAGETV_HOST=127.0.0.1
SAGETV_WEB_PORT=8080

# ChannelsDVR backend
CHANNELS_HOST=127.0.0.1
CHANNELS_PORT=8089

# Model paths (relative or absolute)
LLM_MODEL_PATH=models/llm
WHISPER_MODEL_PATH=models/whisper
WHISPER_MODEL_SIZE=base
TTS_MODEL_PATH=models/tts
TTS_OUTPUT_DIR=/tmp/tts_output

# Debug mode
DEBUG=false
