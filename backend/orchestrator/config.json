{
    "http_port": 8000,
    "mcp_port": 8765,
    "debug": false,
    "llm": {
        "model_path": "models/llm",
        "base_url": "http://127.0.0.1:11434",
        "model": "auto",
        "auto_select_model": true,
        "fallback_model": "hermes3:8b",
        "temperature": 0.7,
        "num_predict": 2048,
        "summary_num_predict": 640,
        "summary_temperature": 0.2,
        "num_ctx": 8192,
        "max_concurrent": 1,
        "gpu_memory_profiles_mb": [
            {"min_mb": 12800, "model": "qwen3:14b"},
            {"min_mb": 9400, "model": "mistral-nemo:latest"},
            {"min_mb": 6144, "model": "hermes3:8b"}
        ],
        "routing": {
            "default_model": "qwen3:14b",
            "complex_model": "qwen3:14b",
            "fast_model": "hermes3:8b",
            "premium_model": "qwen3:14b",
            "complex_min_gpu_mb": 12800,
            "premium_min_gpu_mb": 12800
        }
    },
    "gpu_arbiter": {
        "floor_model": "hermes3:8b",
        "model_ladder": [
            {"model": "qwen3:14b", "vram_mb": 12800, "num_ctx": 32768},
            {"model": "mistral-nemo:latest", "vram_mb": 9400, "num_ctx": 16384},
            {"model": "hermes3:8b", "vram_mb": 6800, "num_ctx": 16384}
        ]
    },
    "whisper": {
        "model_path": "models/whisper",
        "model_size": "base"
    },
    "tts": {
        "model_path": "models/tts",
        "output_dir": "/tmp/tts_output"
    },
    "voice": {
        "max_history": 20,
        "session_ttl": 1800
    },
    "agent": {
        "max_iterations": 5,
        "planner": "openclaw",
        "openclaw": {
            "enabled": true,
            "timeout_ms": 30000,
            "max_plan_depth": 5,
            "strict": false,
            "runtime_callable": ""
        }
    },
    "semantic": {
        "embed_model": "all-MiniLM-L6-v2",
        "embed_device": "cpu",
        "encode_batch_size": 64
    },
    "mcp": {
        "sagetv_host": "127.0.0.1",
        "sagetv_port": 8766,
        "channels_host": "127.0.0.1",
        "channels_port": 8767,
        "linux_host": "127.0.0.1",
        "linux_port": 8768,
        "transcription_host": "127.0.0.1",
        "transcription_port": 8770
    },
    "channels_dvr_url": "http://localhost:8089",
    "sagetv_url": "http://localhost:8080",
    "sagetv_user": "sage",
    "sagetv_pass": "frey",
    "sagetv_credentials_note": "Published defaults (username: sage, password: frey)",
    "session_manager_url": "http://127.0.0.1:8769",
    "paths": {
        "sagetv_media": "/var/media/tv",
        "allowed_log_paths": [
            "/var/log/syslog",
            "/var/log/auth.log",
            "/var/log/kern.log",
            "/var/log/docker.log",
            "/var/log/nginx/error.log",
            "/var/log/nginx/access.log",
            "/opt/sagetv/server/logs/sagetv.log",
            "/tmp/orchestrator.log",
            "/tmp/transcription.log",
            "/tmp/session-manager.log",
            "/tmp/mcp-sagetv.log",
            "/tmp/mcp-channels.log",
            "/tmp/mcp-linux.log"
        ],
        "allowed_browse_roots": [
            "/var/media/tv",
            "/var/media/channels",
            "~/AI-media-RC",
            "/tmp/transcription"
        ]
    },
    "auth": {
        "app_max_age": 1209600,
        "admin_ttl": 14400
    },
    "speech_language": "en-US"
}
